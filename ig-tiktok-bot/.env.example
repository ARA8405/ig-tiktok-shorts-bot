# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Optional: path to a Netscape-format cookies.txt file (helps with Instagram
# rate limiting / login-walled content). Leave blank if not needed.
COOKIES_FILE=

# Optional: max video size in MB the bot will try to upload via the normal
# Telegram Bot API (hard cap is 50MB unless you run a local Bot API server).
MAX_FILE_SIZE_MB=50

# Optional: where temporary downloads are stored before being sent/cleaned up
DOWNLOAD_DIR=downloads

# Optional: comma-separated numeric chat IDs allowed to use the bot.
# Leave blank to allow the bot to respond in any chat/group it's added to.
ALLOWED_CHAT_IDS=

# --- Webhook mode (only needed for serverless hosts like Cloud Run) ---
# Leave all three blank to run in polling mode (the default, used when
# running locally on your own Mac/PC via run.sh / run.bat).

# Public HTTPS base URL of your deployed service, e.g. https://your-service-xyz.a.run.app
# Setting this switches the bot from polling to webhook mode.
WEBHOOK_URL=

# Optional extra security: a random string Telegram will echo back on a
# header so you can verify requests actually came from Telegram. Any
# random string works, e.g. generate one with: openssl rand -hex 24
WEBHOOK_SECRET=

# Port the bot listens on in webhook mode. Cloud Run sets this automatically
# via its own PORT env var, so you normally don't need to set this yourself.
PORT=8080
